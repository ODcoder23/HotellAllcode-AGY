// ============================================================
//  Imron Hotel PMS — Prisma schema
//
//  PMS: sayt, Shaxmatka, admin panel, Telegram botlar va Beds24
//  (channel manager) bilan ikki tomonlama integratsiya. Beds24
//  2026-09-26 da olib tashlangan edi, 2026-09-27 da egasi qarori
//  bilan AVVALGIDEK qaytdi (migratsiya 20260927120000_beds24_restore).
//  Tizim so'mda; faqat Beds24'dan kelgan bron obyekt valyutasida (USD).
//
//  DIQQAT: Prisma bu faylga exclusion constraint yoza olmaydi.
//  Overbooking himoyasi raw SQL migratsiya orqali qo'shilgan
//  (20260912114500_overbooking_guard, `reservation_no_overlap`).
//  Usiz bir xonaga kesishuvchi ikki bron tushishi mumkin.
//
//  Tekshirish:  npx prisma validate
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TZ 18-band: "audit log"
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // "mapping.updated" | "settings.changed" | "webhook.reprocessed" | ...
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// Ishlab turgan serverda o'zgaradigan sozlamalar (services/settings.ts)
model Settings {
  key        String   @id   // "MEAL_PRICE_PER_PERSON" | "SALES_STOP" | ...
  value      String
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

// ===================== FOYDALANUVCHI / RBAC (TZ 18-band) =====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  // Parol oxirgi marta o'zgargan vaqt: undan oldin berilgan token'lar
  // (o'g'irlangan bo'lishi mumkin) qabul qilinmaydi
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())

  auditLogs    AuditLog[]
  employee     Employee?
  payments     Payment[]      // qabul qilgan to'lovlari (S13)
  expenses     Expense[]      // kiritgan xarajatlari (S14)
  cleaningTasks CleaningTask[]  // yuborgan tozalash topshiriqlari
}

enum UserRole {
  FOUNDER   // egasi: hamma narsa + umumiy hisobot, foydalanuvchilar
  ADMIN     // sozlamalar, xodimlar, sayt — moliya hisobotisiz
  MANAGER   // bron, narx, xona yopish
  STAFF     // check-in/check-out, to'lov qabul qilish
}

/**
 * Xodim — kadrlar hisobi.
 *
 * `User` dan FARQI: `User` — tizimga kiradigan hisob (login,
 * parol, rol). `Employee` — mehmonxonada ishlaydigan odam.
 * Farrosh va oshpaz tizimga kirmaydi, lekin ular ham xodim.
 *
 * Bog'liqlik ixtiyoriy: qabulxona xodimining ikkalasi ham bo'ladi,
 * oshpazning faqat `Employee` yozuvi.
 */
model Employee {
  id        String   @id @default(cuid())
  fullName  String
  position  String              // "Qabulxona xodimi", "Farrosh", "Oshpaz"
  phone     String?
  /**
   * Pasport seriyasi va raqami — kadrlar hisobi uchun.
   *
   * Admin panel bu maydonni ko'rsatadi. Mehmonlar pasporti
   * alohida masala (hali hal qilinmagan).
   */
  passport  String?
  /**
   * Xodim rasmi — `data:` URL yoki tashqi havola.
   *
   * Admin panelda karta ustida ko'rinadi. Rasm yo'q bo'lsa
   * standart odam belgisi chiziladi.
   */
  photoUrl  String?
  /** Oylik maosh, so'mda. Hisobotda jami xarajat hisoblanadi. */
  salary    Decimal? @db.Decimal(12, 2)
  hiredAt   DateTime @db.Date
  /** Ishdan bo'shagan sana. null = hali ishlaydi. */
  firedAt   DateTime? @db.Date
  isActive  Boolean  @default(true)
  notes     String?

  /** Tizimga kiradigan xodim bo'lsa — hisobiga bog'lanadi */
  /**
   * Telegram ID — farroshlar guruhida tugma bosganda kim ekanini
   * aniqlash uchun.
   *
   * NEGA KERAK: Telegram faqat `user_id` beradi, bizga esa qaysi
   * xodim ekani kerak — hisobotda "Dilnoza 8 xona tozaladi"
   * ko'rinishi uchun. Bog'lanmagan odam tugma bosa olmaydi.
   *
   * Xodim botga `/id` yozib o'z raqamini bilib oladi.
   */
  telegramId String? @unique

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  cleaningTasks CleaningTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([position])
}

// ===================== MEHMONXONA ASOSIY MODELLARI (TZ 13-band) =====================

// Qavat — o'z ID'si bilan. Xona ID'si kabi, qavat ID'si ham barcha
// tizimlarga (Shaxmatka, admin panel, sayt) bir xil qiymat bo'lib
// tarqaladi.
//
// Nega alohida jadval, `Int` emas: qavatni nomlash ("1-qavat",
// "Mansarda"), butun qavatni bir amalda yopish (ta'mir) va qavat
// bo'yicha hisobot olish kerak. `Int` bilan bularning hech biri
// ishonchli bo'lmaydi.
model Floor {
  id        String  @id            // "F1", "F2" — barcha tizimlarda shu qiymat
  number    Int     @unique        // 1, 2, 3 — tartiblash va ko'rsatish uchun
  label     String                 // "1-qavat"
  isActive  Boolean @default(true) // false = butun qavat inventardan chiqadi
  sortOrder Int     @default(0)

  rooms     Room[]
}

model RoomType {
  id          String   @id            // "standard" | "double" | "deluxe" — Shaxmatka bilan bir xil kalit
  label       String                  // "Standart" | "Ikki kishilik" | "Lyuks"
  multiplier  Float    @default(1)    // Shaxmatkadagi ROOM_TYPES.multiplier bilan bir xil
  maxAdults   Int      @default(2)    // Website qidiruvida filtr
  sortOrder   Int      @default(0)

  // --- Sayt uchun (2026-09-17) -----------------------------
  //
  // Sayt bu maydonlarni allaqachon kutardi (`index.html`
  // loadRooms: `t.description`, `t.image`), lekin model ularni
  // bermasdi — natijada xonalar rasmsiz va tavsifsiz ko'rinardi.

  /** Mehmonga ko'rinadigan tavsif */
  description String?
  /** Asosiy rasm — `data:` URL yoki havola */
  imageUrl    String?
  /** Qo'shimcha rasmlar (galereya) */
  gallery     Json?
  /** Qulayliklar: ["Konditsioner", "Wi-Fi", "Balkon"] */
  amenities   Json?
  /** Saytda ko'rsatilsinmi — vaqtincha yashirish uchun */
  showOnSite  Boolean  @default(true)

  rooms        Room[]
  ratePlans    RatePlan[]
  availability Availability[]
  channelMappings ChannelMapping[]   // Beds24 xona turi bog'lanishi
}

// Q2: Room.id — xona raqamining o'zi ("101"), cuid() EMAS.
// Shaxmatka frontendi aynan shu shaklda ishlaydi, o'zgartirilmaydi.
model Room {
  id          String     @id          // "101", "102", "202" — xona raqami = ID
  number      String     @unique      // id bilan bir xil qiymat, o'qishga qulaylik uchun

  // Qavat raqami sifatida ham saqlanadi (`floor`), ID sifatida ham
  // (`floorId`). Birinchisi Shaxmatka bilan moslik uchun — u
  // `room.floor` ni son deb o'qiydi va o'zgartirilmaydi. Ikkinchisi
  // barcha tizimlar uchun yagona identifikator.
  floor       Int
  floorId     String?
  floorRef    Floor?     @relation(fields: [floorId], references: [id])

  roomTypeId  String
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
  status      RoomStatus @default(AVAILABLE)   // joriy jismoniy holat (sanaga bog'liq emas)
  isActive    Boolean    @default(true)        // false = inventarda umuman hisoblanmaydi
  sortOrder   Int        @default(0)

  reservations Reservation[]
  dayStatuses  RoomDayStatus[]
  cleaningTasks CleaningTask[]
  channelMappings ChannelMapping[]   // Beds24 xona (unit) bog'lanishi
  channelBlocks   ChannelBlock[]     // Beds24 `black` bronlari

  @@index([floorId])
}

// Shaxmatkadagi ROOM_STATUS bilan aynan bir xil qiymatlar
enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

// TZ 1-band: "mehmon ma'lumotlari"
model Guest {
  id          String   @id @default(cuid())
  fullName    String
  // Telefon MAJBURIY (2026-09-17 qarori) — sayt va
  // qabulxona validatsiyasi talab qiladi. Ustun `String?`: eski
  // yozuvlarda telefon bo'lmasligi mumkin.
  phone       String?
  email       String?
  country     String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]

  @@index([phone])
  @@index([email])
}

model Reservation {
  id                    String   @id @default(cuid())
  roomId                String
  room                  Room     @relation(fields: [roomId], references: [id])
  guestId               String
  guest                 Guest    @relation(fields: [guestId], references: [id])

  // TZ 1-band maydonlari
  checkIn               DateTime @db.Date
  checkOut              DateTime @db.Date
  adults                Int      @default(1)
  children              Int      @default(0)
  // Bron valyutasida. 4 xona: OTA jami narxi yoki sayt tariflari
  // kechalarga bo'linganda kasr qoldig'i yo'qolmasin ($100 / 3 = 33.3333
  // -> x3 = $100.00). Jami — lib/money.ts, 2 xonaga yaxlitlanadi
  pricePerNight         Decimal  @db.Decimal(12, 4)
  // Bron valyutasi (egasi qarori Q15): tizim so'mda, faqat Beds24'dan
  // kelgan bron obyekt valyutasida (USD). Bronning BARCHA summalari
  // (narx, nonushta, xizmat, to'lov, jarima) shu valyutada
  currency              String   @default("UZS")
  // 1 birlik `currency` necha so'm — bron KELGAN kundagi Markaziy bank
  // kursi (Q15, 2026-09-27 tasdiqlandi). Qotadi: "tagida so'm", so'mda
  // qabul qilingan to'lov va hisobot shu kurs bilan. So'm bronida bo'sh
  exchangeRate          Decimal? @db.Decimal(14, 4)
  source                ReservationSource
  notes                 String?
  withMeal              Boolean  @default(false)   // Shaxmatkada mavjud maydon

  // Narx tarifdan past bo'lsa sabab yoziladi.
  // Hisobotda "nega arzon sotilgan" ko'rinib tursin.
  priceReason           String?

  // Bekor qilish jarimasi. Kech bekor qilinsa
  // 1 kecha narxi olinadi — bu DAROMAD, shuning uchun alohida
  // yoziladi va hisobotga tushadi.
  cancellationFee       Decimal? @db.Decimal(12, 2)

  // Nonushta: kishi boshiga narx.
  // Bron yaratilganda o'sha paytdagi narx KO'CHIRILADI — keyin
  // narx o'zgarsa eski bronlar summasi o'zgarmasin.
  mealPricePerPerson    Decimal? @db.Decimal(12, 2)

  // TZ 8-band
  status                ReservationStatus @default(CONFIRMED)

  // TZ 1-band: "check-in", "check-out" — vaqt sifatida ham saqlanadi
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  cancelledAt           DateTime?

  /**
   * Mehmonga ko'rsatiladigan bron kodi — "IMR-8F3K2".
   *
   * Faqat Website'dan kelgan bronlarda bo'ladi: mijoz bronini shu
   * kod bilan tekshiradi. Ichki `id` (cuid) berilmaydi — u uzun va
   * ketma-ket emasligi kafolatlanmagan.
   */
  code                  String?  @unique

  // TZ 9-band: duplicate himoyasi — Beds24 bron raqami kanal bilan birga noyob
  channelId             String?          // null = hali Beds24'ga yuborilmagan / ichki bron
  channel               Channel? @relation(fields: [channelId], references: [id])
  externalReservationId String?          // Beds24 bookingId

  // Bron qayerda tug'ilgan (B2): PMS — sayt, qabulxona, admin;
  // CHANNEL — Beds24'dan kelgan (OTA yoki Beds24 paneli). OTA broni
  // sanasi/narxi/bekor qilinishi OTA'niki (Q9) — `lib/channelOwnership.ts`
  origin                ReservationOrigin @default(PMS)
  // OTA'dagi bron raqami (Booking.com'da mehmon ko'radigan) — Beds24
  // `apiReference`. Qo'lda kiritilgan OTA broni importda shu bilan bog'lanadi
  externalReference     String?

  // Beds24 bilan sinxron holati (TZ 13, 17-band): PMS bron amali
  // Beds24'ni kutmaydi — navbat yuboradi, holat shu yerda
  syncStatus            EntitySyncStatus @default(PENDING)
  // Oxirgi yuborish xatosi (REJECTED / FAILED) — Shaxmatka va jurnal ko'rsatadi
  syncError             String?
  lastSyncedAt          DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  charges               Charge[]
  payments              Payment[]
  expenses              Expense[]   // avtomatik OTA komissiyasi

  // TZ 9-band: "Unique constraint bo'lsin ... duplicate reservation yaratilmasin"
  @@unique([channelId, externalReservationId])
  @@index([roomId, checkIn, checkOut])
  @@index([status])
  @@index([syncStatus])
  @@index([externalReference])
}

// Bron qayerda tug'ilgan — `Reservation.origin`, `ChannelBlock.origin`
enum ReservationOrigin {
  PMS
  CHANNEL
}

/**
 * Beds24 bilan sinxron holati.
 *
 * REJECTED (2026-09-27): Beds24 bronni rad etdi (joy yo'q, validatsiya).
 * Qayta yuborish foydasiz — avtomatik qayta urinilmaydi. 2026-09-26 gacha
 * bunday bron FAILED bo'lib qolar va har 15 daqiqada qayta POST qilinardi
 * (Beds24 tarixini aynan shu to'ldirgan). Bron PMS'da o'zgarsa (xona,
 * sana) — PENDING bo'lib yana yuboriladi.
 */
enum EntitySyncStatus {
  PENDING         // navbatga qo'yilgan, hali yuborilmagan
  SYNCING         // hozir yuborilmoqda — parallel yuborishni to'sadi
  SYNCED          // Beds24 qabul qildi
  FAILED          // vaqtinchalik xato (tarmoq, 5xx, kredit) — catch-up qayta uradi
  REJECTED        // Beds24 rad etdi — xodim hal qiladi, avtomatik qayta yuborilmaydi
  NOT_APPLICABLE  // Beds24'ga tegishli emas: mapping yo'q, o'tmish yoki bekor qilingan
}

// Shaxmatkadagi SOURCES bilan aynan bir xil qiymatlar. OTA manbalari
// (Booking.com va h.k.) qabulxonada qo'lda kiritilgan bronlar uchun —
// komissiya hisobi shunga qaraydi (services/expenses.ts)
enum ReservationSource {
  DIRECT
  WEBSITE
  BOOKING_COM
  AIRBNB
  EXPEDIA
  OSTROVOK
  PHONE
  WALK_IN
  OTHER
}

// TZ 8-band: oltitasi ham to'liq qo'llab-quvvatlanadi (mijoz qarori Q5)
enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Charge {
  id            String   @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  label         String
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@index([reservationId])
}

// TZ 14-band
model Payment {
  id                String   @id @default(cuid())
  reservationId     String
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount            Decimal  @db.Decimal(12, 2)   // BRON valyutasida; manfiy = qaytarish
  // Mehmon boshqa valyutada to'lasa (Q15: dollar bronda so'm) — asl
  // summa, valyuta va kurs. `amount` = asl / kurs. Kurs — bron kursi
  // (bron kelgan kun), shuning uchun so'mdagi qarz o'zgarmaydi
  originalAmount    Decimal? @db.Decimal(14, 2)
  originalCurrency  String?
  exchangeRate      Decimal? @db.Decimal(14, 4)
  method            String                        // "Naqd" | "Karta" | "Bank o'tkazmasi" | "Onlayn"
  paymentDate       DateTime @db.Date             // Shaxmatkadagi payment.date
  note              String?
  externalPaymentId String?                       // Beds24 invoice item ("b24item:<id>")
  channelId         String?                       // qaysi kanal orqali to'langan
  createdAt         DateTime @default(now())

  // Kim qabul qildi. Naqd pul yo'qolsa javobgar
  // ko'rinib tursin. Xodim hisobi o'chirilsa ham to'lov yozuvi
  // qoladi -> SetNull.
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /**
   * Qaytarish qaysi to'lovniki (2026-09-27). UNIQUE — bitta to'lov
   * faqat BIR marta qaytariladi (baza darajasida). Ilgari tekshiruv
   * faqat "qaytarish umumiy to'langandan oshmasin" edi: ikki to'lov
   * bo'lsa birinchisini ikki marta qaytarib, ikkinchisini "yo'q" qilish
   * mumkin edi. Eski qaytarishlarda bo'sh (izohdan aniqlab bo'lmaydi).
   */
  reversedPaymentId String?  @unique
  reversedPayment   Payment? @relation("PaymentReversal", fields: [reversedPaymentId], references: [id], onDelete: SetNull)
  reversal          Payment? @relation("PaymentReversal")

  @@unique([channelId, externalPaymentId])  // bir Beds24 to'lovi ikki marta yozilmasin
  @@index([reservationId])
  @@index([userId])
}

/**
 * Telegram bot ruxsat darajasi.
 *
 * FULL    — Moliya, Xonalar, Bronlar, Dashboard
 * LIMITED — Xonalar, Bronlar, Dashboard (moliya YO'Q)
 *
 * Farosh bu jadvalda BO'LMAYDI — u `Employee.telegramId`
 * orqali tanaladi va faqat topshiriqlarini ko'radi.
 */
enum BotAccessLevel {
  FULL
  LIMITED
}

/**
 * Botga kirish huquqi.
 *
 * NEGA JADVAL, `.env` EMAS: egasi admin panelda ruxsat qo'shishi
 * va olib tashlashi kerak. `.env` o'zgarishi server qayta ishga
 * tushirilishini talab qiladi.
 *
 * `.env` dagi `TELEGRAM_FOUNDER_IDS` zaxira sifatida qoladi:
 * baza ishlamay qolsa ham egasi botdan foydalana olsin.
 */
model BotAccess {
  id          String         @id @default(cuid())
  botType     String         @default("FOUNDER") // "FOUNDER" | "KITCHEN"
  telegramId  String?
  username    String?        // "@" siz, kichik harflarda: "odcoder23"
  label       String         // "Bosh oshpaz Rustam", "Menejer Jamshid"
  level       BotAccessLevel @default(FULL)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  createdById String?

  @@index([isActive])
  @@index([botType])
  @@index([telegramId])
  @@index([username])
}

/**
 * Tozalash topshirig'i holati.
 *
 * Farosh tugma bosgani sari o'zgaradi. Telegram xabari ham
 * shu holatga qarab tahrirlanadi.
 */
enum CleaningStatus {
  NEW          // faroshga yuborildi, hali qabul qilmadi
  IN_PROGRESS  // farosh qabul qildi, tozalamoqda
  /**
   * Farosh "Tozaladim" bosdi, admin hali tasdiqlamadi.
   *
   * 2026-09-17 da qo'shildi: egasi tozalash sifatini
   * tekshirishni xohladi. Xona bu holatda HALI SOTILMAYDI —
   * faqat tasdiqlangandan keyin ochiladi.
   */
  PENDING      // tasdiqlash kutilmoqda
  DONE         // admin tasdiqladi, xona sotishga tayyor
  CANCELLED    // admin bekor qildi yoki boshqaga berdi
}

/**
 * Tozalash topshirig'i.
 *
 * NEGA JADVAL KERAK, faqat Telegram xabari emas:
 *   - Xabar o'chirilsa topshiriq yo'qolardi
 *   - Kim necha xona tozalagani hisoblanmasdi
 *   - Bot qayta ishga tushsa holatni bilmasdi
 *
 * IKKI MANBA, BIR XIL MANTIQ (2026-09-17 qarori):
 *   `isAuto = true`  — mehmon chiqdi, avtomatik
 *   `isAuto = false` — admin panelda qo'lda yuborildi
 *
 * Ikkalasi ham guruhga bir xil ko'rinishda boradi va bir xil
 * tugmalar bilan ishlaydi.
 */
model CleaningTask {
  id          String         @id @default(cuid())
  roomId      String
  room        Room           @relation(fields: [roomId], references: [id])
  status      CleaningStatus @default(NEW)

  /** "Mehmon chiqdi" (avtomatik) yoki admin yozgan sabab */
  reason      String
  isAuto      Boolean        @default(false)

  /** Qo'lda yuborilgan bo'lsa — kim yubordi */
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /**
   * Kim bajardi — xodim yozuvi (ixtiyoriy).
   *
   * Guruh mantig'ida (2026-09-17) topshiriq oldindan hech kimga
   * biriktirilmaydi, shuning uchun bu maydon odatda bo'sh.
   * Telegram ID `Employee` bilan bog'langan bo'lsa to'ldiriladi
   * va hisobot ikkalasi bilan ham ishlaydi.
   */
  employeeId  String?
  employee    Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  /**
   * Guruhda tugmani kim bosgani (2026-09-17).
   *
   * NEGA ISM YETARLI: guruhda faqat farroshlar bor va kim
   * olgani hammaga ko'rinadi — bu o'z-o'zini nazorat qiladi.
   * `Employee` yozuvi shart emas, ro'yxatga yangi farosh
   * qo'shish uchun hech narsa sozlash kerak emas.
   *
   * `claimedByName` — Telegram'dagi ismi ("Dilnoza"), xodim
   * ismi emas. Hisobotda shu ko'rsatiladi.
   */
  claimedByTelegramId String?
  claimedByName       String?

  /**
   * Telegram xabarini TAHRIRLASH uchun kerak.
   *
   * Har bosishda yangi xabar emas, o'shasi o'zgaradi — guruh
   * to'lib ketmaydi.
   */
  chatId      String?
  messageId   Int?

  createdAt   DateTime       @default(now())
  acceptedAt  DateTime?
  /** Farosh "Tozaladim" bosgan vaqt */
  finishedAt  DateTime?
  /** Tozalangan xona rasmi (farrosh Telegram orqali yuboradi) */
  photoUrl    String?
  /** Admin tasdiqlagan vaqt */
  doneAt      DateTime?
  /** Kim tasdiqladi */
  approvedById String?

  @@index([status, createdAt])
  @@index([roomId])
  @@index([employeeId])
}

/**
 * Xarajat turlari.
 *
 * NEGA ENUM: erkin matn bo'lsa bir xil xarajat turli nomlar bilan
 * yozilib, hisobotda guruhlanmay qolardi ("kommunal", "Kommunal",
 * "svet puli").
 */
enum ExpenseCategory {
  UTILITIES      // suv, elektr, gaz
  FOOD           // oziq-ovqat, oshxona
  MAINTENANCE    // ta'mir, jihoz
  TAX            // soliq
  MARKETING      // reklama
  COMMISSION     // OTA komissiyasi (avtomatik hisoblanadi)
  SALARY         // maosh (Employee'dan avtomatik, qo'lda ham mumkin)
  OTHER          // boshqa
}

/**
 * Xarajat.
 *
 * NEGA KERAK: ilgari hisobotda FAQAT maosh xarajat sifatida
 * hisoblanardi. Kommunal, soliq va ayniqsa OTA komissiyasi
 * (Booking.com 15-18%) hisobga olinmagani uchun foyda
 * haqiqatdan katta ko'rinardi.
 *
 * `isAuto` — tizim o'zi hisoblagan (komissiya) yoki qo'lda
 * kiritilgan. Avtomatik yozuvlar qayta hisoblanganda
 * o'chiriladi, qo'lda kiritilganlarga tegilmaydi.
 */
model Expense {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  note        String?

  // Kim kiritgani — naqd xarajat uchun javobgarlik
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Avtomatik hisoblangan (OTA komissiyasi) — qo'lda emas
  isAuto      Boolean         @default(false)
  // Komissiya qaysi bronga tegishli (auto yozuvlar uchun). Bron
  // o'chirilsa komissiyasi ham ketadi — yetim yozuv qolmasin
  reservationId String?
  reservation Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())

  @@index([date, category])
  @@index([reservationId])
  @@index([userId])
}

// TZ 7-band: kunlik narx, so'mda. Admin Narxlar panelida qo'yadi (Q8),
// Beds24'ga kurs bilan dollarda yuboriladi (services/rates.ts)
model RatePlan {
  id          String   @id @default(cuid())
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id])
  date        DateTime @db.Date
  price       Decimal  @db.Decimal(12, 2)
  // Cheklovlar (TZ 10-band) — Beds24 kalendariga (OTA'larga) boradi.
  // null = PMS bu cheklovni boshqarmaydi: yuborilmaydi, Beds24'dagisi
  // buzilmaydi. PMS o'zi (sayt, qabulxona) hozircha majburlamaydi
  minStay         Int?     // kamida necha kecha (1 = cheklovsiz)
  maxStay         Int?     // ko'pi bilan necha kecha (0 = cheklovsiz)
  // Beds24'da bitta `override` maydoni — ikkalasi birga boshqariladi
  // (biri null bo'lsa ikkinchisi ham null)
  closedArrival   Boolean? // shu kuni kirish yo'q (CTA)
  closedDeparture Boolean? // shu kuni chiqish yo'q (CTD)
  source      String   @default("pms")   // "pms" | "beds24" — oxirgi yangilanish qayerdan kelgan
  syncedAt    DateTime?                   // Beds24'ga yuborilgan vaqt (null = yuborilmagan)
  syncError   String?                     // oxirgi yuborish xatosi (panel belgisi)
  // Beds24'dagi narx — kanal valyutasida (so'm narx / kurs = $). Oxirgi
  // yuborilgan yoki tortilgan qiymat: tortishda "bu bizning narxmi" shu
  // bilan solishtiriladi, kurs o'zgargani narxni buzmaydi
  channelPrice Decimal? @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([date])
  @@index([syncedAt])
}

// ===================== AVAILABILITY (TZ 6, 13-band) =====================

// Tur x kun bo'yicha bo'sh xonalar keshi — sayt qidiruvi shundan
// o'qiydi. Qiymat bronlar va RoomDayStatus'dan hisoblanadi
// (services/availability.ts), qo'lda yozilmaydi.
model Availability {
  id            String   @id @default(cuid())
  roomTypeId    String
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  totalRooms    Int      // shu turdagi sotuvdagi xonalar (faol, ta'mirda emas)
  bookedRooms   Int      // band qilinganlari
  blockedRooms  Int      // shu kuni yopiq (RoomDayStatus)
  availableCount Int     // = totalRooms - bookedRooms - blockedRooms
  updatedAt     DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([date])
}

// Xona darajasidagi kunlik holat — PMS ichki haqiqat manbai.
// TZ 5-band "Deluxe → Room 202" talabi aynan shu darajada bajariladi.
model RoomDayStatus {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id])
  date          DateTime @db.Date
  isBlocked     Boolean  @default(false)   // ta'mir/xizmatdan chiqarilgan
  blockReason   String?
  updatedAt     DateTime @updatedAt

  @@unique([roomId, date])
  @@index([date])
}

// ============================================================
//  KANAL — Beds24 (channel manager), TZ 1, 5, 9-13, 16-band
//
//  Ikki tomonlama integratsiya (2026-09-27 da qaytdi, BEDS24.md):
//    Beds24 -> PMS  bronlar (webhook + polling), narx (soatlik),
//                   yopiq kunlar (`black`)
//    PMS -> Beds24  bronlar (checkAvailability bilan), narx (so'm / kurs),
//                   yopiq kunlar (`black` bron)
//  Beds24 ustuvor (Q9): bo'sh joy sonini Beds24 bronlardan o'zi hisoblaydi.
// ============================================================

model Channel {
  id        String   @id @default(cuid())
  code      String   @unique // "beds24"
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  connections  ChannelConnection[]
  mappings     ChannelMapping[]
  webhooks     WebhookEvent[]
  syncLogs     SyncLog[]
  syncStates   SyncState[]
  reservations Reservation[]
  blocks       ChannelBlock[]
}

/**
 * Beds24 ulanishi. Tokenlar AES-256-GCM bilan shifrlangan
 * (`lib/encryption.ts`, kalit `.env` dagi ENCRYPTION_KEY) va
 * hech qachon javobga chiqmaydi (TZ 13, 18-band).
 */
model ChannelConnection {
  id                   String    @id @default(cuid())
  channelId            String
  channel              Channel   @relation(fields: [channelId], references: [id])
  refreshToken         String // shifrlangan
  accessToken          String? // shifrlangan, 24 soatlik kesh
  accessTokenExpiresAt DateTime?
  propertyId           String // Beds24 obyekt ID
  isActive             Boolean   @default(true)
  /**
   * Oxirgi "Ulanishni tekshirish" natijasi
   */
  lastCheckedAt        DateTime?
  lastCheckOk          Boolean?
  lastError            String?
  /**
   * Token ruxsatlari (`GET /authentication/details`)
   */
  scopes               Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([channelId, propertyId])
}

/**
 * TZ 5-band: "Har bir mapping database'da saqlansin". Ikki daraja:
 *   tur  — Beds24 xona turi (roomId) -> PMS tarif (RoomType)
 *   unit — Beds24 roomId + unitId -> PMS xona (Room). Unit id har
 *          turda 1 dan boshlanadi — faqat roomId bilan birga noyob
 * Mapping topilmasa sync RAD ETILADI — taxminiy bog'lash yo'q.
 */
model ChannelMapping {
  id                 String    @id @default(cuid())
  channelId          String
  channel            Channel   @relation(fields: [channelId], references: [id])
  roomTypeId         String?
  roomType           RoomType? @relation(fields: [roomTypeId], references: [id])
  roomId             String?
  room               Room?     @relation(fields: [roomId], references: [id])
  /**
   * Beds24 obyekti (property) — TZ 11-band `external_property_id`.
   * Boshqa obyektga ulanganda bu obyektning bog'lanishlari nofaol
   * bo'ladi, qaytib ulanganda tiklanadi (services/mapping.ts)
   */
  externalPropertyId String?
  externalRoomTypeId String // Beds24 "roomId" (xona turi)
  externalUnitId     String? // Beds24 unit (jismoniy xona)
  /**
   * Beds24'dagi nomi — mapping sahifasi va "Beds24: tur ..." yozuvi uchun
   */
  externalName       String?
  /**
   * Beds24 tarifi nonushtani o'z ichiga oladimi — shu turdan kelgan
   * bron `withMeal` bo'ladi (oshxona sanaydi)
   */
  includesMeal       Boolean   @default(false)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([channelId, externalRoomTypeId, externalUnitId])
  @@unique([channelId, roomId])
  @@index([channelId, roomTypeId])
}

/**
 * TZ 10-band: webhook — saqlash, dedup, navbat. Imzo yo'q (Beds24
 * bermaydi) — himoya URL'dagi maxfiy token (`WEBHOOK_URL_TOKEN`)
 */
model WebhookEvent {
  id           String        @id @default(cuid())
  channelId    String
  channel      Channel       @relation(fields: [channelId], references: [id])
  eventType    String // "booking.new" | "booking.modified" | "booking.cancelled" | ...
  externalId   String? // Beds24 bookingId
  payloadHash  String // SHA-256 (vaqt maydonlarisiz) — takrorni aniqlash
  rawPayload   Json
  status       WebhookStatus @default(RECEIVED)
  attempts     Int           @default(0)
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime      @default(now())

  // DIQQAT: createdAt kirmaydi — aks holda dedup ishlamaydi
  @@unique([channelId, eventType, externalId, payloadHash])
  @@index([channelId, externalId])
  @@index([status, createdAt])
}

enum WebhookStatus {
  RECEIVED
  QUEUED
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
  NEEDS_MANUAL_ACTION // mapping yo'q / bo'sh xona yo'q — admin hal qiladi
}

/**
 * TZ 16-band: har bir Beds24 muloqoti — channel, action, request,
 * response, status, error, timestamp, reservation ID
 */
model SyncLog {
  id            String        @id @default(cuid())
  channelId     String
  channel       Channel       @relation(fields: [channelId], references: [id])
  action        String // "push_reservation" | "poll_bookings" | "push_rates" | "pull_rates" | ...
  direction     SyncDirection
  reservationId String?
  roomId        String?
  request       Json? // sanitizeForLog() dan o'tgan
  response      Json?
  status        SyncStatus
  attempt       Int           @default(1)
  errorMessage  String?
  durationMs    Int?
  createdAt     DateTime      @default(now())

  @@index([channelId, status, createdAt])
  @@index([channelId, action, createdAt])
  @@index([reservationId])
}

enum SyncDirection {
  PMS_TO_CHANNEL
  CHANNEL_TO_PMS
}

enum SyncStatus {
  SUCCESS
  FAILED
  RETRYING
  SKIPPED
}

// TZ 10-band: polling uchun "oxirgi muvaffaqiyatli sync" nuqtasi
model SyncState {
  id               String    @id @default(cuid())
  channelId        String
  channel          Channel   @relation(fields: [channelId], references: [id])
  key              String // "bookings_pull"
  lastSuccessfulAt DateTime?
  lastCursor       String?
  updatedAt        DateTime  @updatedAt

  @@unique([channelId, key])
}

/**
 * Xona yopilishi <-> Beds24 `black` bron (B2).
 *
 * Beds24'da xona yopish — `status: "black"` bron. PMS'da esa kunma-kun
 * `RoomDayStatus.isBlocked`. Bu jadval ikkalasini bog'laydi:
 *   origin = PMS     — PMS'da ta'mirga yopildi, Beds24'ga black bron
 *                      yuborildi (OTA'da xona yopiladi)
 *   origin = CHANNEL — Beds24 panelida yopildi, PMS'da kunlar yopiq
 * Bitta yozuv = bitta xonaning ketma-ket yopiq kunlari (`[)` oraliq).
 */
model ChannelBlock {
  id         String            @id @default(cuid())
  channelId  String
  channel    Channel           @relation(fields: [channelId], references: [id])
  roomId     String
  room       Room              @relation(fields: [roomId], references: [id])
  fromDate   DateTime          @db.Date // birinchi yopiq kun
  toDate     DateTime          @db.Date // oxirgi yopiq kundan keyingi kun
  externalId String? // Beds24 black bron id
  origin     ReservationOrigin
  reason     String?
  isActive   Boolean           @default(true) // false — ochilgan / bekor
  syncStatus EntitySyncStatus  @default(PENDING)
  syncError  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([channelId, externalId])
  @@index([roomId, isActive])
}
