# ============================================================
#  Imron Hotel PMS — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# --- Database -----------------------------------------------
DATABASE_URL="postgresql://imron:imron@localhost:5432/imron_pms?schema=public"

# --- Redis (davriy vazifalar, WebSocket pub/sub) ------------
REDIS_URL="redis://localhost:6379"

# --- Server -------------------------------------------------
PORT=3000
NODE_ENV=development
# Serverda "127.0.0.1" — port internetdan ochiq bo'lmasin (Nginx orqali)
# HOST="127.0.0.1"

# --- Xavfsizlik (TZ 18-band) --------------------------------
# 32+ belgi — yaratish:  openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# JWT majburiy. STANDART — yoqilgan: o'zgaruvchi yo'q bo'lsa ham auth
# ishlaydi. Faqat lokal sinovda "false" (hamma so'rov ADMIN deb olinadi).
# NODE_ENV=production da "false" bilan server ishga tushmaydi.
AUTH_REQUIRED="true"

# Rate limiting. Testlarda "true" (o'chirilgan): testlar o'nlab
# so'rov yuboradi va cheklovga urilib qolishi mumkin.
# PRODUCTION'DA "false" — cheklov yoqilgan bo'lishi kerak.
RATE_LIMIT_DISABLED="false"

# CORS — ruxsat etilgan domenlar (vergul bilan).
# Bo'sh bo'lsa faqat bir xil origin ishlaydi. Frontend
# backendning o'zidan xizmat qilingani uchun odatda bo'sh
# qoladi. Sayt alohida domenda bo'lsa shu yerga yoziladi:
#   CORS_ORIGINS="https://imron-hotel.uz"
CORS_ORIGINS=""

# --- Biznes qoidalari ---------------------------------------
# To'lanmagan SAYT broni shuncha soatdan keyin avtomatik bekor bo'ladi
PENDING_PAYMENT_TIMEOUT_HOURS=24

# --- Telegram bot (founder uchun) ---------------------------
# Token: @BotFather -> /newbot
# Bo'sh bo'lsa bot ishga tushmaydi, backend normal ishlaydi.
TELEGRAM_BOT_TOKEN=""

# Kim kira oladi. O'z ID'ingizni bilish: botga /id yozing,
# yoki @userinfobot ga /start.
# Vergul bilan bir nechta: "123456789,987654321"
TELEGRAM_FOUNDER_IDS=""

# Yangi bron kelganda avtomatik xabar yuborilsinmi
TELEGRAM_NOTIFY_BOOKINGS="true"

# --- 2-bot: Tozalik -----------------------------------------
# Guruh ID'si manfiy ("-100..." — supergruh)
TELEGRAM_CLEANING_BOT_TOKEN=""
TELEGRAM_CLEANING_GROUP_ID=""

# --- 3-bot: Oshxona -----------------------------------------
TELEGRAM_KITCHEN_BOT_TOKEN=""
TELEGRAM_KITCHEN_CHAT_ID=""

# --- Channel manager: Beds24 KUZATUVI (faqat egasi) ---------
# 2026-09-27: PMS Beds24'dan faqat O'QIYDI va solishtiradi, hech narsa
# yozmaydi. Ulanish admin paneldan (Channel manager -> Ulash) qilinadi.
#
# Beds24 tokenini bazada shifrlash kaliti (64 hex). Bo'sh bo'lsa server
# ishlaydi, faqat Beds24'ga ulanib bo'lmaydi.
#   openssl rand -hex 32
ENCRYPTION_KEY=""

# Beds24 API manzili (odatda o'zgartirilmaydi)
# BEDS24_BASE_URL="https://beds24.com/api/v2"

# Davriy tekshiruv (bronlar, narx, farq), daqiqa. 0 — faqat tugma bilan
CHANNEL_MONITOR_MINUTES=60
# Bo'sh joy va narx necha kun oldinga solishtiriladi
CHANNEL_HORIZON_DAYS=60

# Webhook: https://<domen>/api/webhooks/beds24/<WEBHOOK_URL_TOKEN>
# Bo'sh — webhook qabul qilinmaydi (bronlar davriy tekshiruvda o'qiladi).
# Kamida 16 belgi:  openssl rand -hex 24
WEBHOOK_URL_TOKEN=""

# Dollar kursi manbai (Markaziy bank) — odatda o'zgartirilmaydi
# FX_CBU_URL="https://cbu.uz/uz/arkhiv-kursov-valyut/json/USD/"
